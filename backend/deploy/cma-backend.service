[Unit]
Description=CMA Backend (FastAPI/Uvicorn)
After=network.target

[Service]
Type=simple
User=datascience
Group=datascience
WorkingDirectory=/home/datascience/CMA/backend
ExecStart=/home/datascience/CMA/backend/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

# Hardening (safe for a single-purpose app service)
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
